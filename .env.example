# ============================================================
# Dharma Environment Variables
# Copy this to .env and fill in your actual keys
# ============================================================

# Pexels API key for stock backgrounds (get at pexels.com/api)
PEXELS_API_KEY=

# YouTube Data API v3 key (free, optional - for trending discovery)
YOUTUBE_DATA_API_KEY=

# Ollama settings (optional, for LLM-based content)
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
